{
  "expo": {
    "name": "Spark Youth",
    "slug": "spark-youth",
    "version": "0.1.8",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.sparkyouth.mobile",
      "versionCode": 9,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "extra": {
      "supportsRTL": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "اسمح لسبارك باختيار صورة الهوية أو وصل الإيداع التي تحددها.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-android-network.cjs"
    ],
    "icon": "../admin/public/media/spark-logo.png"
  }
}
